-- | Mock USDCx fungible token for local bridge development.
-- Models the UTXO-style holding pattern used by CIP-56 on Canton.
-- Each contract represents one discrete balance owned by a single party.
-- The issuer (BridgeOperator) is the sole signatory; the owner is an observer
-- who controls Split, Merge, and Transfer via Daml's flexible-controller feature.
module MockUSDCx where

template MockUSDCxHolding
  with
    issuer : Party    -- BridgeOperator who minted this holding
    owner  : Party    -- current holder
    amount : Decimal  -- balance (mirrors USDC's 6-decimal precision, stored as Decimal)
  where
    signatory issuer
    observer  owner
    ensure    amount > 0.0

    -- | Split this holding into two. The total amount is preserved.
    -- The smaller piece goes to splitAmount; the remainder stays as a new holding.
    choice Split
      : (ContractId MockUSDCxHolding, ContractId MockUSDCxHolding)
      with
        splitAmount : Decimal
      controller owner
      do
        assertMsg "splitAmount must be positive" (splitAmount > 0.0)
        assertMsg "splitAmount must be less than total" (splitAmount < amount)
        cid1 <- create this with amount = splitAmount
        cid2 <- create this with amount = amount - splitAmount
        return (cid1, cid2)

    -- | Merge another holding of the same issuer into this one.
    -- The other holding is archived; a new combined holding is returned.
    choice Merge
      : ContractId MockUSDCxHolding
      with
        otherCid : ContractId MockUSDCxHolding
      controller owner
      do
        other <- fetch otherCid
        assertMsg "Issuer must match" (other.issuer == issuer)
        assertMsg "Owner must match"  (other.owner  == owner)
        archive otherCid
        create this with amount = amount + other.amount

    -- | Transfer ownership to a new party.
    -- The issuer remains; only the owner field changes.
    choice Transfer
      : ContractId MockUSDCxHolding
      with
        newOwner : Party
      controller owner
      do
        create this with owner = newOwner

    -- | Burn this holding (issuer-only).
    -- Reserved for the future unlock flow when tokens are redeemed back to Plasma.
    choice Burn
      : ()
      controller issuer
      do return ()
