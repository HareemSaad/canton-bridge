-- | BridgeReceiver — one-shot intent contract for an incoming Plasma → Canton transfer.
-- The relayer creates one of these for each Lock event observed on the Plasma subgraph,
-- then immediately exercises Mint to produce a MockUSDCxHolding for the recipient.
-- Keeping the two steps separate gives an on-ledger audit trail of every bridge transfer.
module BridgeReceiver where

import MockUSDCx

template BridgeReceiver
  with
    bridgeOperator : Party  -- authorises minting; matches MockUSDCxHolding.issuer
    recipient      : Party  -- Canton party that will receive the tokens
    plasmaToken    : Text   -- EVM token address locked on Plasma (audit trail)
    plasmaTxHash   : Text   -- Plasma transaction hash (audit trail)
    nonce          : Int    -- lock nonce from the Plasma Gateway contract (dedup key)
    amount         : Decimal
  where
    signatory bridgeOperator
    observer  recipient
    ensure    amount > 0.0

    -- | Mint: archive this intent and issue a MockUSDCxHolding to the recipient.
    -- Called by the relayer immediately after creating the BridgeReceiver.
    choice Mint
      : ContractId MockUSDCxHolding
      controller bridgeOperator
      do
        create MockUSDCxHolding with
          issuer = bridgeOperator
          owner  = recipient
          amount = amount
