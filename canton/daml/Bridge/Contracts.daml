-- | Core bridge contracts for the Plasma → Canton direction.
--
-- MintCommand is created and immediately exercised by the relayer for each
-- validated DepositToCanton event.  It atomically:
--   1. Records the EVM tx hash in BridgeState (replay guard)
--   2. Mints a CIP56Holding via TokenConfig.IssuerMint (creates audit event)
module Bridge.Contracts where

import Bridge.State
import CIP56.Config
import CIP56.Token

-- | One-shot command created and exercised by the relayer for each deposit.
template MintCommand
  with
    issuer        : Party                    -- ^ Bridge operator
    recipient     : Party                    -- ^ Canton party receiving the holding
    amount        : Decimal
    txHash        : Text                     -- ^ EVM transaction hash (dedup key)
    fingerprint   : Text                     -- ^ EVM bytes32 fingerprint (hex, no 0x)
    chainRef      : Text                     -- ^ Source chain (e.g. "plasma")
    tokenConfigId : ContractId TokenConfig
    bridgeStateId : ContractId BridgeState
  where
    signatory issuer
    ensure    amount > 0.0

    -- | Execute: replay-guard → mint → return holding contract ID.
    choice Execute
      : ContractId CIP56Holding
      with dummy : ()
      controller issuer
      do
        -- 1. Record tx hash (reverts if duplicate)
        newStateId <- exercise bridgeStateId RecordMint with txHash = txHash

        -- 2. Mint CIP-56 holding with audit trail
        holdingId <- exercise tokenConfigId IssuerMint with
          recipient      = recipient
          amount         = amount
          externalTxHash = txHash
          fingerprint    = fingerprint
          chainRef       = chainRef

        return holdingId

-- ─── Canton → Plasma (deposit-to-plasma) ─────────────────────────────────────

data DepositToPlasmaStatus
  = DepositPending
  | DepositCompleted Text   -- ^ EVM tx hash on success
  | DepositFailed    Text   -- ^ error reason
  deriving (Eq, Show)

-- | Request created by the user to burn their CIP-56 holding and receive EVM
--   tokens.  The relayer (issuer) accepts the request atomically: burns the
--   holding via IssuerBurn and creates a DepositToPlasmaEvent.
template DepositToPlasma
  with
    user         : Party                 -- ^ Canton party initiating the withdrawal
    issuer       : Party                 -- ^ Bridge operator (will Accept)
    holdingId    : ContractId CIP56Holding
    amount       : Decimal
    evmRecipient : Text                  -- ^ Target EVM address (hex)
    fingerprint  : Text                  -- ^ User's EVM bytes32 fingerprint (no 0x)
  where
    signatory user
    observer  issuer

    -- | Burn the holding and emit a DepositToPlasmaEvent for the relayer to
    --   complete on the EVM side.
    choice Accept
      : ContractId DepositToPlasmaEvent
      with tokenConfigId : ContractId TokenConfig
      controller issuer
      do
        holding <- fetch holdingId
        assertMsg "Holding owner mismatch"  (holding.owner  == user)
        assertMsg "Holding amount mismatch" (holding.amount == amount)
        exercise tokenConfigId IssuerBurn with
          holdingId      = holdingId
          externalTxHash = "pending"   -- updated to EVM tx hash once confirmed
        create DepositToPlasmaEvent with
          issuer       = issuer
          user         = user
          amount       = amount
          evmRecipient = evmRecipient
          fingerprint  = fingerprint
          status       = DepositPending

-- | Mutable relay state for a Canton → Plasma withdrawal tracked by the relayer.
template DepositToPlasmaEvent
  with
    issuer       : Party
    user         : Party
    amount       : Decimal
    evmRecipient : Text
    fingerprint  : Text
    status       : DepositToPlasmaStatus
  where
    signatory issuer
    observer  user

    choice Complete
      : ContractId DepositToPlasmaEvent
      with evmTxHash : Text
      controller issuer
      do create this with status = DepositCompleted evmTxHash

    choice Fail
      : ContractId DepositToPlasmaEvent
      with reason : Text
      controller issuer
      do create this with status = DepositFailed reason

