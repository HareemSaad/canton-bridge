# ── mode ──────────────────────────────────────────────────────────────────────
# "local" uses LOCAL_* vars (Anvil + local subgraph + local postgres + local Canton sandbox)
# "prod"  uses PROD_*  vars (Alchemy RPC + hosted subgraph + prod postgres + prod Canton)
MODE=local

# ── local profile ─────────────────────────────────────────────────────────────
LOCAL_DATABASE_URL=postgresql://relayer:relayer@localhost:5433/relayer
LOCAL_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/gateway-local
LOCAL_PLASMA_RPC=http://localhost:8545
LOCAL_CANTON_URL=http://localhost:7575
# Copy the BridgeOperator party ID printed when `daml start` runs (format: BridgeOperator::<fingerprint>)
LOCAL_CANTON_PARTY_ID=
LOCAL_CANTON_TOKEN=                   # leave blank — local sandbox has no auth

# ── prod profile ──────────────────────────────────────────────────────────────
PROD_DATABASE_URL=postgresql://user:pass@prod-db-host:5432/relayer
PROD_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/gateway/version/latest
PROD_PLASMA_RPC=https://plasma-testnet.g.alchemy.com/v2/<api-key>
PROD_CANTON_URL=https://canton-participant.example.com
PROD_CANTON_PARTY_ID=BridgeOperator::<prod-fingerprint>
PROD_CANTON_TOKEN=<jwt>

# ── shared ────────────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=30000
PENDING_CHECK_INTERVAL_MS=60000
SUBGRAPH_PAGE_SIZE=100
# Number of decimal places for the bridged EVM token (USDC/USDT = 6)
CANTON_TOKEN_DECIMALS=6
PORT=3000
NODE_ENV=development
